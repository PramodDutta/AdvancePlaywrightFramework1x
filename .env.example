# Copy to .env and fill in. .env is gitignored; this template is committed.

# --- TTACart login credentials ---
STANDARD_USER=standard_user
TTA_SECRET=tta_secret

# --- Environment / base URL (see playwright.config.ts) ---
# TTA_ENV=qa                 # qa | stg | prod | dev
# BASE_URL=                  # overrides everything if set
# LOG_LEVEL=info

# --- AI Agent Factory (src/ai) — model list lives in src/ai/models.json ---
# LLM_PROVIDER=openrouter      # openrouter | groq | openai  (default: openrouter)
# LLM_MODEL=                   # optional; overrides the provider's defaultModel
# Set only the key matching LLM_PROVIDER:
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OpenRouter optional attribution headers:
# OPENROUTER_HTTP_REFERER=https://thetestingacademy.com
# OPENROUTER_X_TITLE=AdvancePlaywrightFramework
