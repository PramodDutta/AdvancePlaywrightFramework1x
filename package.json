{
  "name": "advanceplaywrightframework1x",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test --grep @e2e",
    "test:p0": "playwright test --grep @p0",
    "test:p1": "playwright test --grep @p1",
    "test:report": "playwright show-report",
    "test:report:ci": "playwright show-report --host 0.0.0.0 --port 9323",
    "test:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "test:bdd": "cucumber-js",
    "test:bdd:smoke": "cucumber-js --tags @smoke",
    "test:bdd:report": "open reports/cucumber/report.html",
    "test:bdd:tta": "cucumber-js && open tta-report/index.html",
    "cucumber": "cucumber-js",
    "cucumber:level0": "HEADED=1 cucumber-js --profile level0",
    "cucumber:level1": "HEADED=1 cucumber-js --profile level1",
    "cucumber:level2": "HEADED=1 cucumber-js --profile level2",
    "cucumber:level2:report": "HEADED=1 cucumber-js --profile level2 && open tta-report/index.html",
    "cucumber:headed": "HEADED=1 cucumber-js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "build": "tsc",
    "clean": "rm -rf dist playwright-report test-results allure-results allure-report node_modules/.cache"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-playwright": "^3.9.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsonpath-plus": "^10.4.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.60.1",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}